# Config file dedicated to the user's personal zshrc profile shared between all exegol containers.
# This file is sourced in /root/.zshrc file.
# Alternatively, the /opt/my-resources/setup/load_user_setup.sh file can be used to operate the change once (instead of sourcing a file for each zsh instance)

reset() {
  rm -rf /workspace/*
  mkdir -p /workspace/
  echo "[+] Workspace wiped and reset"
}

listen() {
  local PORT=""
  local USE_NCAT=false
  for arg in "$@"; do
    case "$arg" in
      --nc)
        USE_NCAT=true
        ;;
      *)
        PORT="$arg"
        ;;
    esac
  done
  if [[ -z "$PORT" ]]; then
    echo "Usage: listen <port> [--nc]"
    return 1
  fi
  if $USE_NCAT; then
    echo "[+] Listening on 0.0.0.0:$PORT with netcat"
    nc -lvnp "$PORT"
  else
    echo "[+] Listening on 0.0.0.0:$PORT with pwncat-cs"
    pwncat-cs -lp "$PORT"
  fi
}

# Aliases
alias -- c=clear
alias -- cat='bat --style=plain --pager=never'
alias -- l='eza -lah --git --icons=always'
alias -- ll='eza -lah --git --icons=always'
alias -- ls='eza --icons=always'
alias -- tree='eza -T --icons'

# --- Navigation et édition de mot avec Ctrl ---
bindkey '^[[1;5D' backward-word     # Ctrl+Flèche gauche
bindkey '^[[1;5C' forward-word      # Ctrl+Flèche droite
bindkey '^w' kill-word              # Ctrl+W pour effacer un mot
bindkey '^H' backward-kill-word     # Ctrl+Backspace pour effacer mot arrière

# --- Démarrage automatique tmux ---
[[ -z "$TMUX" && -t 0 && -t 1 ]] && exec tmux new-session -A -s main
